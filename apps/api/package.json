{
  "name": "@changelog-studio/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Changelog Studio HTTP API (Express + SQLite).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
