# Copy to .env for local development.
PORT=4000
# File path for the SQLite database. Use ":memory:" for an ephemeral store.
DATABASE_PATH=./data/changelog.sqlite
# Comma-separated list of allowed CORS origins.
CORS_ORIGIN=http://localhost:5173
# Optional. When set, write endpoints require "Authorization: Bearer <token>".
# Leave empty to keep writes open (public playground / local dev).
API_TOKEN=
